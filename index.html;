<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Trainers Vault, LLC</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, sans-serif;
      background: #07111f;
      color: #ffffff;
      line-height: 1.6;
    }

    nav {
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 10;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 8%;
      background: rgba(2, 6, 23, 0.82);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    nav .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 900;
      letter-spacing: 0.5px;
    }

    nav .brand img {
      width: 42px;
      height: 42px;
      object-fit: cover;
      border-radius: 50%;
      background: white;
    }

    nav a {
      color: #e5e7eb;
      text-decoration: none;
      margin-left: 18px;
      font-weight: 700;
      font-size: 0.95rem;
    }

    nav a:hover {
      color: #facc15;
    }

    header {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 120px 20px 60px;
      background:
        radial-gradient(circle at top left, rgba(250, 204, 21, 0.22), transparent 30%),
        radial-gradient(circle at bottom right, rgba(124, 58, 237, 0.4), transparent 35%),
        linear-gradient(135deg, #0f172a, #1e3a8a, #7c3aed);
      overflow: hidden;
    }

    .hero {
      max-width: 920px;
    }

    .hero-badge {
      display: inline-block;
      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(255, 255, 255, 0.24);
      padding: 8px 16px;
      border-radius: 999px;
      margin-bottom: 22px;
      color: #fef9c3;
      font-weight: 800;
    }

    .logo {
      width: 185px;
      height: 185px;
      object-fit: cover;
      border-radius: 50%;
      border: 5px solid #ffffff;
      margin-bottom: 26px;
      background: #ffffff;
      box-shadow: 0 20px 55px rgba(0, 0, 0, 0.35);
    }

    h1 {
      font-size: clamp(2.7rem, 8vw, 5.6rem);
      margin-bottom: 14px;
      letter-spacing: 1px;
      line-height: 1;
    }

    .tagline {
      font-size: clamp(1.1rem, 3vw, 1.55rem);
      margin: 0 auto 32px;
      color: #e0e7ff;
      max-width: 720px;
    }

    .buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      justify-content: center;
    }

    .btn {
      text-decoration: none;
      color: #0f172a;
      background: #facc15;
      padding: 15px 25px;
      border-radius: 999px;
      font-weight: 900;
      transition: 0.2s ease;
      display: inline-block;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
    }

    .btn:hover {
      transform: translateY(-3px);
      background: #fde047;
    }

    .btn.secondary {
      background: #ffffff;
    }

    .btn.dark {
      background: #111827;
      color: #ffffff;
      border: 1px solid rgba(255,255,255,0.2);
    }

    section {
      padding: 78px 20px;
      max-width: 1120px;
      margin: auto;
    }

    .section-title {
      text-align: center;
      font-size: clamp(2rem, 5vw, 2.7rem);
      margin-bottom: 16px;
    }

    .section-text {
      text-align: center;
      max-width: 780px;
      margin: 0 auto 42px;
      color: #cbd5e1;
      font-size: 1.12rem;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 25px;
    }

    .card {
      background: linear-gradient(180deg, #1e293b, #111827);
      padding: 30px;
      border-radius: 24px;
      border: 1px solid #334155;
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.25);
    }

    .card h3 {
      color: #facc15;
      margin-bottom: 10px;
      font-size: 1.45rem;
    }

    .card p, .card li {
      color: #cbd5e1;
    }

    .card ul {
      margin-left: 20px;
      margin-top: 10px;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 26px;
      align-items: center;
    }

    .feature-image {
      background: #ffffff;
      border-radius: 30px;
      padding: 14px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.35);
    }

    .feature-image img {
      width: 100%;
      border-radius: 22px;
      display: block;
    }

    .stream-box {
      background:
        radial-gradient(circle at top right, rgba(250,204,21,0.24), transparent 28%),
        linear-gradient(135deg, #7c3aed, #2563eb);
      border-radius: 30px;
      padding: 48px 26px;
      text-align: center;
      margin-top: 20px;
      border: 1px solid rgba(255,255,255,0.18);
      box-shadow: 0 20px 55px rgba(0,0,0,0.28);
    }

    .stream-box h2 {
      font-size: clamp(1.8rem, 5vw, 2.4rem);
      margin-bottom: 15px;
    }

    .stream-box p {
      margin-bottom: 18px;
      color: #e0e7ff;
      font-size: 1.08rem;
    }

    .contact-list {
      display: grid;
      gap: 12px;
      max-width: 620px;
      margin: 0 auto 25px;
    }

    .contact-list a, .contact-list span {
      background: rgba(255,255,255,0.12);
      color: #ffffff;
      text-decoration: none;
      padding: 14px 16px;
      border-radius: 16px;
      font-weight: 800;
      border: 1px solid rgba(255,255,255,0.14);
    }

    footer {
      text-align: center;
      padding: 35px 20px;
      background: #020617;
      color: #94a3b8;
    }

    footer a {
      color: #facc15;
      text-decoration: none;
      margin: 0 8px;
    }

    @media (max-width: 760px) {
      nav {
        padding: 12px 18px;
      }

      nav .links {
        display: none;
      }

      .feature-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
